# ==============================
# Tracked on purpose: package data (the tutorial herd, lookup-table overrides). tests/ needs no exception; Python caches stay ignored everywhere.
# ==============================
!domains/**/data/
!domains/**/data/**
!src/**/data/
!src/**/data/**

# Last, so that the data exceptions above can never re-include a Python cache
__pycache__/
*.py[cod]

